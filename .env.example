# Firebase web app configuration, used only for cookieless usage analytics.
# Find the values in the Firebase console: Project settings > Your apps > Web app.
# Copy this file to .env.local (git-ignored) and fill it in. While the API key,
# app ID or measurement ID are empty, analytics stays off.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=resumy-4464b.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=resumy-4464b
VITE_FIREBASE_STORAGE_BUCKET=resumy-4464b.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
